# Production/UAT config, OPTIONALLY externally mounted at
# /app/config/application.properties (via
# --spring.config.additional-location=optional:file:/app/config/ in the
# Dockerfile). The "optional:" prefix means the app now boots correctly even
# if this file/mount is absent entirely — it is no longer required.
#
# This ADDS TO, does not replace, the application.properties bundled inside the jar —
# any key not set here falls back to the bundled default.
#
# COMPATIBILITY NOTE (path configuration): file.cache.path and
# app.base64.output-path used to be hardcoded here to container-specific
# values (/app/cache, /app/cache/base64-output). They are no longer set in
# this file at all — the bundled defaults are now environment-variable-driven
# (FILE_CACHE_PATH, BASE64_OUTPUT_PATH, LOG_DIR; see docs/Configuration.md),
# so the same jar/image now works across every environment without a
# per-deployment properties file. If an existing deployment's tooling still
# expects paths under /app/cache, set the environment variables to those
# values instead of editing this file, e.g.:
#   FILE_CACHE_PATH=/app/cache
#   BASE64_OUTPUT_PATH=/app/cache/base64-output
# Nothing below this line needs to change per-deployment; it is kept for
# operators who prefer an explicit, versioned config file over env vars.

spring.application.name=convert2base64
logging.level.org.springframework.web.client.RestTemplate=INFO

file.cache.retention-hours=24
file.cache.audit.rotation-enabled=true
file.cache.audit.archive-enabled=true
file.cache.audit.archive-retention-days=7

app.base64.output-enabled=true
app.base64.retention-days=7
app.decoded-file.retention-days=7

# ─── Default auth / content type ─────────────────────────────────────────────
app.default.auth.token=q4ynVHA2s4d3unfWY2ujrQ==
app.default.content.type=application/json
